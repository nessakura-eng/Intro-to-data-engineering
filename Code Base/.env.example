# Copy this file to .env.local and fill in your Supabase project values
# (Supabase dashboard > Project Settings > API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional: set to false to hide the sample-account shortcuts on the login screen.
# VITE_SHOW_DEMO_ACCOUNTS=true
# Optional: the day the sample data treats as "today" (default 2026-10-19).
# VITE_DEMO_TODAY=2026-10-19
# Only for `npm run seed:auth` (Supabase dashboard > Project Settings > API > service_role).
# Keep this secret. Never commit it, and never put it in a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
